#!/bin/sh
# herdr-agents — launcher for the JavaScript entry (herdr-agents.mjs, next
# to this file). Runs the entry with node when it is on PATH and is version
# 20 or newer, else with bun; passes every argument through and exits with
# the runtime's code. The directory is resolved physically (pwd -P), so the
# launcher also works when it is invoked through a symlinked directory
# (the setup hooks call it that way).

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 2

node_bin=$(command -v node 2>/dev/null || true)
if [ -n "$node_bin" ]; then
  node_major=$("$node_bin" -e 'process.stdout.write(String(process.versions.node.split(".")[0]))' 2>/dev/null || true)
  case $node_major in
    ''|*[!0-9]*) : not a usable node version ;;
    *)
      if [ "$node_major" -ge 20 ]; then
        exec "$node_bin" "$script_dir/herdr-agents.mjs" "$@"
      fi
      ;;
  esac
fi

bun_bin=$(command -v bun 2>/dev/null || true)
if [ -n "$bun_bin" ]; then
  exec "$bun_bin" "$script_dir/herdr-agents.mjs" "$@"
fi

printf 'herdr-agents: needs Node.js 20+ or Bun\n' >&2
exit 2
